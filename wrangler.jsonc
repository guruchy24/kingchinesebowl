{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "kingchinesebowl",
	"compatibility_date": "2026-10-02",
	"cache": { "enabled": true },
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "kingchinesebowl"
		}
	],
	"hyperdrive": [ { "binding": "DB", "id": "96fa71f375ca4415b3ba77bb73c0d0e3" } ],
	"images": {
		"binding": "IMAGES"
	},
	"kv_namespaces": [
		{
			"binding": "NEXT_CACHE_WORKERS_KV",
			"id": "3d208b48acad4eb1a6bca84beba6115a"
		}
	]
}
